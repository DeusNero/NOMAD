PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-in-production
NODE_ENV=development
TRUSTED_MODE=false
TRUSTED_NAME=Household
ALLOW_BOOTSTRAP_REGISTRATION=false

# Comma-separated absolute directories that the Knowledgebase may index or write to.
# In production these must be set before saving Knowledgebase settings.
KNOWLEDGEBASE_ALLOWED_VAULT_ROOTS=/path/to/your/obsidian-vault/wiki/japan
KNOWLEDGEBASE_ALLOWED_UPLOAD_ROOTS=/path/to/your/obsidian-vault/raw/japan
